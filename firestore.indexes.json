{
  "//": "對應 API_CONTRACT.md §5.3。缺少這些索引時，App 的查詢會在執行期失敗並在 console 附上建立連結。",
  "indexes": [
    {
      "//": "站位詳情：載入某站位的可見回報，最新在前",
      "collectionGroup": "reports",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "stationUID", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "已選路線模式：載入該路線沿線的回報",
      "collectionGroup": "reports",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "routeUID", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "交叉比對計數：查同站同路線在時效內的誤點回報數",
      "collectionGroup": "reports",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "stopUID", "order": "ASCENDING" },
        { "fieldPath": "routeUID", "order": "ASCENDING" },
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "地圖標記：以 geohash 前綴範圍查詢視野內的站位聚合",
      "collectionGroup": "stopAggregates",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "geohash", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "刪除排程：撈出待處理的請求",
      "collectionGroup": "deletionRequests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "requestedAt", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "//": "TTL：回報 10 分鐘後自動刪除。需另在 Firebase Console 啟用 TTL 政策指向 expiresAt。",
      "collectionGroup": "reports",
      "fieldPath": "expiresAt",
      "ttl": true,
      "indexes": []
    },
    {
      "collectionGroup": "reportSecrets",
      "fieldPath": "expiresAt",
      "ttl": true,
      "indexes": []
    },
    {
      "//": "頻率限制紀錄只需存活比限制窗口稍長的時間",
      "collectionGroup": "rateLimits",
      "fieldPath": "expiresAt",
      "ttl": true,
      "indexes": []
    }
  ]
}
