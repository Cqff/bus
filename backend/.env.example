# 複製為 .env 後填入。.env 已被 .gitignore 擋住，絕不可進版控。
#
# 申請流程：
#   1. 至 https://tdx.transportdata.tw/ 註冊會員
#   2. 會員中心 → 資料服務 → 取得 API 金鑰
#   3. 複製 Client Id 與 Client Secret 填入下方
#
# 貼上時不要加引號，也注意不要夾帶前後空白或換行 ——
# 這是認證失敗最常見的原因。可用 `npm run diagnose` 檢查。

TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 服務設定
PORT=8080
TDX_CITY=Taipei

# 動態資料拉取間隔（毫秒）。
#
# ⚠️ 不要調低於 30000。
#
# 實測（2026-07-31）TDX 一般會員配額為**每 30 秒 5 次**。
# 每輪拉 A1 + N1 共 2 次呼叫，30 秒間隔在任一窗口內最多 4 次，剛好在配額內。
# 設 15 秒會產生 6 次而被 429 擋住。
#
# 拉更快也沒有意義 —— TDX 動態資料官方更新頻率本來就是每分鐘。
# 可用 `npm run measure-quota` 重新確認你這把金鑰的實際配額。
POLL_INTERVAL_MS=30000

# 回應快取秒數，須與 Firebase Hosting 的 CDN 設定一致
CACHE_MAX_AGE_SEC=15
