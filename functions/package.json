{
  "name": "busmap-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "comment": "src/core/ 刻意不 import 任何 Firebase 套件，因此 `npm test` 不需要先 npm install。"
}
